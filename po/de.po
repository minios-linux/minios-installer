#, python-brace-format
msgid "Create {role} {fstype} partition: {start}MiB-{end}MiB ({size}MiB)"
msgstr "{role} {fstype}-Partition erstellen: {start}MiB-{end}MiB ({size}MiB)"

#: lib/partition_planner.py:48
msgid "The EFI payload does not fit the fixed 100 MiB EFI system partition."
msgstr "Das EFI-Payload passt nicht auf die festgelegte 100 MiB EFI-Systempartition."

#: lib/partition_planner.py:75
msgid "No partition table was found. Use erase-all to initialize this disk."
msgstr "Keine Partitionstabelle gefunden. Verwenden Sie 'erase-all', um diese Festplatte zu initialisieren."

#: lib/partition_planner.py:78
msgid "BIOS/MBR layout cannot be used with existing GPT free space. Choose Automatic/UEFI-GPT or erase the disk."
msgstr "BIOS/MBR-Layout kann nicht mit vorhandenem GPT-Freier Speicher verwendet werden. Wählen Sie Automatisch/UEFI-GPT oder löschen Sie die Festplatte."

#: lib/partition_planner.py:81
msgid "Existing GPT free space cannot be used from a BIOS boot without BIOS-on-GPT bootloader support. Boot the installer under UEFI, force UEFI/GPT if you know the target firmware supports it, or erase the disk for BIOS/MBR."
msgstr "Freier GPT-Speicherplatz kann ohne BIOS-on-GPT-Bootloader-Unterstützung nicht von einem BIOS-Boot genutzt werden. Starten Sie das Installationsprogramm unter UEFI, erzwingen Sie UEFI/GPT, wenn die Ziel-Firmware dies unterstützt, oder löschen Sie die Festplatte für BIOS/MBR."

#: lib/partition_planner.py:86
msgid "UEFI/GPT layout cannot be used with existing MBR free space. Choose Automatic/BIOS-MBR or erase the disk."
msgstr "UEFI/GPT-Layout kann nicht mit vorhandenem MBR-Freier Speicher verwendet werden. Wählen Sie Automatisch/BIOS-MBR oder löschen Sie die Festplatte."

#: lib/partition_planner.py:106
#, python-brace-format
msgid "Not enough space for MiniOS root partition (need at least {need} MiB, have {have} MiB)"
msgstr "Nicht genügend Platz für MiniOS-Root-Partition (mindestens {need} MiB benötigt, {have} MiB vorhanden)"

#: lib/partition_planner.py:151
msgid "BIOS firmware cannot reliably boot a GPT layout. Erase-all requires MBR on BIOS; disks 2 TiB or larger are not supported in this mode. Use a smaller disk or boot the installer under UEFI."
msgstr "BIOS-Firmware kann ein GPT-Layout nicht zuverlässig starten. Löschen erfordert MBR auf BIOS; Festplatten ab 2 TiB werden in diesem Modus nicht unterstützt. Verwenden Sie eine kleinere Festplatte oder starten Sie das Installationsprogramm unter UEFI."

#: lib/partition_planner.py:248
#, python-brace-format
msgid "No suitable free space available (need at least {need} MiB)"
msgstr "Kein geeigneter freier Speicherplatz verfügbar (mindestens {need} MiB erforderlich)"

#: lib/partition_planner.py:254
msgid "Not enough MBR primary partition slots for this free-space install. Use erase-all, remove a partition, or use a GPT/UEFI layout."
msgstr "Nicht genügend primäre MBR-Partitionsplätze für diese Installation im freien Speicherbereich. Verwenden Sie 'erase-all', entfernen Sie eine Partition oder nutzen Sie ein GPT/UEFI-Layout."

#: lib/partition_planner.py:294
msgid "The resized free space cannot be represented safely in MiB-aligned partitions."
msgstr "Der verkleinerte freie Speicherplatz kann nicht sicher in MiB-ausgerichteten Partitionen dargestellt werden."

#: lib/partition_planner.py:306
msgid "This placement mode is not implemented yet"
msgstr "Dieser Platzierungsmodus ist noch nicht implementiert"

#: lib/partition_planner.py:307
#, python-brace-format
msgid "Unsupported placement: {placement}"
msgstr "Nicht unterstützte Platzierung: {placement}"

