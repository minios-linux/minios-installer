msgstr "Dateisystemprüfung vor dem Verkleinern fehlgeschlagen."

#: lib/partition_executor.py:352
msgid "Failed to resize filesystem."
msgstr "Dateisystem konnte nicht verkleinert werden."

#: lib/partition_executor.py:353
msgid "Filesystem check failed after resize."
msgstr "Dateisystemprüfung nach dem Verkleinern fehlgeschlagen."

#: lib/partition_executor.py:356
