#: share/applications/minios-installer.desktop:124
msgid "install;"
msgstr "installieren;"

#: share/polkit/org.minios.installer.policy:17
msgid "Authentication is required to run MiniOS Installer"
msgstr "Authentifizierung ist erforderlich, um das MiniOS-Installationsprogramm auszuführen"

#~ msgid "UEFI/GPT install: EFI files copied; no BIOS bootloader written."
#~ msgstr "UEFI/GPT-Installation: EFI-Dateien kopiert; kein BIOS-Bootloader geschrieben."

#~ msgid "Choose between a modular live system and a regular Linux installation, then select a security profile."
#~ msgstr "Wählen Sie zwischen einem modularen Live-System und einer regulären Linux-Installation und legen Sie anschließend ein Sicherheitsprofil fest."

#~ msgid "This image supports live installation only; you can still choose the security profile."
#~ msgstr "Dieses Abbild unterstützt nur die Live-Installation; Sie können dennoch das Sicherheitsprofil auswählen."

#~ msgid "Choose how MiniOS should work after installation: as a modular live system or as a regular Linux system."
#~ msgstr "Wählen Sie, wie MiniOS nach der Installation funktionieren soll: als modulares Live-System oder als reguläres Linux-System."

#~ msgid "This live image supports only live system installation with the current installer."
#~ msgstr "Dieses Live-Image unterstützt mit dem aktuellen Installer nur die Installation als Live-System."

#~ msgid "Live system installation"
#~ msgstr "Live-System-Installation"

#~ msgid "Modular live system: keeps MiniOS modules and can save changes between reboots. Designed for portable installations, especially on USB drives."
#~ msgstr "Modulares Live-System: behält MiniOS-Module und kann Änderungen zwischen Neustarts speichern. Entwickelt für portable Installationen, insbesondere auf USB-Laufwerken."

#~ msgid "Full installation"
#~ msgstr "Vollständige Installation"

#~ msgid "Regular Linux system: MiniOS is unpacked to disk and changes are saved directly. Live modules and separate session storage are not used."
#~ msgstr "Reguläres Linux-System: MiniOS wird auf die Festplatte entpackt und Änderungen werden direkt gespeichert. Live-Module und separater Sitzungspeicher werden nicht verwendet."

#~ msgid "Full installation is unavailable because this live image does not provide the native-install metadata required by the current installer."
#~ msgstr "Eine vollständige Installation ist nicht verfügbar, da dieses Live-Image die für den aktuellen Installer erforderlichen native-install-Metadaten nicht bereitstellt."

#~ msgid "Language of the boot menu on the installed system. For a full install this is also used if the installer cannot set up the standard GRUB bootloader."
#~ msgstr "Sprache des Boot-Menüs auf dem installierten System. Bei einer vollständigen Installation wird diese ebenfalls verwendet, falls das Installationsprogramm den Standard-GRUB-Bootloader nicht einrichten kann."

#~ msgid "Choose modules to install. Selecting one also includes all lower layers."
#~ msgstr "Wählen Sie die zu installierenden Module aus. Die Auswahl eines Moduls schließt automatisch alle darunterliegenden Ebenen ein."

#, python-brace-format
#~ msgid "{selected} of {total} layers selected. Estimated native system data: {size}. Required root space with reserve: {required}."
#~ msgstr "{selected} von {total} Ebenen ausgewählt. Geschätzte native Systemdaten: {size}. Benötigter Root-Speicher mit Reserve: {required}."

#~ msgid "MiB (native install only)"
#~ msgstr "MiB (nur bei nativer Installation)"

