msgstr "Partitionsgeräte sind nicht rechtzeitig erschienen: {missing}"

#: lib/partition_executor.py:439
msgid "BIOS plans must not reuse an EFI system partition."
msgstr "BIOS-Pläne dürfen keine EFI-Systempartition wiederverwenden."

