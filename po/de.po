msgstr "NTFS-Resize-Validierung fehlgeschlagen."

#: lib/partition_executor.py:360
msgid "Failed to resize NTFS."
msgstr "NTFS konnte nicht verkleinert werden."

#: lib/partition_executor.py:363
msgid "Unsupported resize filesystem."
msgstr "Nicht unterstütztes Dateisystem für Verkleinerung."

#: lib/partition_executor.py:373
msgid "Failed to update resized partition boundary."
msgstr "Die Grenze der verkleinerten Partition konnte nicht aktualisiert werden."

#: lib/partition_executor.py:380
msgid "Kernel partition geometry does not match the resize plan."
msgstr "Die Kernel-Partitionsgeometrie stimmt nicht mit dem Resize-Plan überein."

#: lib/partition_executor.py:382
msgid "NTFS check failed after resize."
msgstr "NTFS-Prüfung nach dem Verkleinern fehlgeschlagen."

