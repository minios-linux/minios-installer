msgstr "Die vergrößerte Partition hat den geplanten freien Bereich nicht erzeugt."

#: lib/partition_executor.py:230
msgid "ESP reuse plan is incomplete; refusing to modify the disk."
msgstr "Der ESP-Wiederverwendungsplan ist unvollständig; die Festplatte wird nicht verändert."

#: lib/partition_executor.py:234 lib/partition_executor.py:447
msgid "Planned ESP identity changed after the plan was created."
msgstr "Die geplante ESP-Identität wurde nach der Erstellung des Plans geändert."

#: lib/partition_executor.py:243
msgid "Could not mount the reused ESP for free-space validation."
msgstr "Die wiederverwendete ESP konnte zur Überprüfung des freien Speicherplatzes nicht eingehängt werden."

#: lib/partition_executor.py:255
msgid "Reused ESP does not have enough free space for transactional EFI publication."
msgstr "Die wiederverwendete ESP bietet nicht genügend freien Speicherplatz für eine transaktionale EFI-Veröffentlichung."

#: lib/partition_executor.py:263
msgid "Could not unmount the reused ESP after validation."
msgstr "Die wiederverwendete ESP konnte nach der Validierung nicht ausgehängt werden."

#: lib/partition_executor.py:274
msgid "EFI tree contains an unsafe directory."
msgstr "Der EFI-Baum enthält ein unsicheres Verzeichnis."

#: lib/partition_executor.py:278
msgid "EFI tree contains an unsafe file."
msgstr "Der EFI-Baum enthält eine unsichere Datei."

#: lib/partition_executor.py:300
msgid "Could not inspect target device stack; refusing erase-all."
msgstr "Das Zielgeräte-Stack konnte nicht geprüft werden; \"Alles löschen\" wird verweigert."

#: lib/partition_executor.py:302
msgid "Target participates in an active mapped storage stack; refusing erase-all."
msgstr "Das Ziel ist Teil eines aktiven gemappten Storage-Stacks; \"Alles löschen\" wird verweigert."

#: lib/partition_executor.py:307
msgid "Target has active block-device holders; refusing erase-all."
msgstr "Das Ziel hat aktive Block-Device-Halter; \"Alles löschen\" wird verweigert."

#: lib/partition_executor.py:309
msgid "Could not inspect target block-device holders; refusing erase-all."
msgstr "Block-Device-Halter des Ziels konnten nicht geprüft werden; \"Alles löschen\" wird verweigert."

#: lib/partition_executor.py:318
msgid "Could not inspect active swap; refusing erase-all."
msgstr "Aktiver Swap konnte nicht geprüft werden; \"Alles löschen\" wird verweigert."

#: lib/partition_executor.py:320
msgid "Failed to disable swap on target disk."
msgstr "Swap auf dem Ziellaufwerk konnte nicht deaktiviert werden."

#: lib/partition_executor.py:326
msgid "Target swap remains active; refusing erase-all."
msgstr "Der Swap auf dem Ziel bleibt aktiv; \"Alles löschen\" wird verweigert."

#: lib/partition_executor.py:328
msgid "Could not recheck active swap; refusing erase-all."
msgstr "Aktiver Swap konnte nicht erneut geprüft werden; \"Alles löschen\" wird verweigert."

