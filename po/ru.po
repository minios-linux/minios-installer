#: lib/partition_planner.py:65
msgid "No partition table was found. Use erase-all to initialize this disk."
msgstr "Таблица разделов не найдена. Используйте erase-all для инициализации этого диска."

#: lib/partition_planner.py:68
msgid "BIOS/MBR layout cannot be used with existing GPT free space. Choose Automatic/UEFI-GPT or erase the disk."
msgstr "Схема BIOS/MBR не может быть использована с существующим свободным пространством GPT. Выберите Автоматически/UEFI-GPT или очистите диск."

#: lib/partition_planner.py:71
msgid "Existing GPT free space cannot be used from a BIOS boot without BIOS-on-GPT bootloader support. Boot the installer under UEFI, force UEFI/GPT if you know the target firmware supports it, or erase the disk for BIOS/MBR."
msgstr "Свободное пространство GPT не может быть использовано для загрузки через BIOS без поддержки загрузчика BIOS-on-GPT. Загрузите установщик в режиме UEFI, принудительно выберите UEFI/GPT, если прошивка это поддерживает, или очистите диск для BIOS/MBR."

#: lib/partition_planner.py:76
msgid "UEFI/GPT layout cannot be used with existing MBR free space. Choose Automatic/BIOS-MBR or erase the disk."
msgstr "Схема UEFI/GPT не может быть использована с существующим свободным пространством MBR. Выберите Автоматически/BIOS-MBR или очистите диск."

#: lib/partition_planner.py:96
#, python-brace-format
msgid "Not enough space for MiniOS root partition (need at least {need} MiB, have {have} MiB)"
msgstr "Недостаточно места для корневого раздела MiniOS (необходимо минимум {need} MiB, доступно {have} MiB)"

#: lib/partition_planner.py:141
msgid "BIOS firmware cannot reliably boot a GPT layout. Erase-all requires MBR on BIOS; disks 2 TiB or larger are not supported in this mode. Use a smaller disk or boot the installer under UEFI."
msgstr "Прошивка BIOS не может надежно загрузить схему GPT. Для полной очистки требуется MBR на BIOS; диски 2 ТиБ и больше не поддерживаются в этом режиме. Используйте меньший диск или загрузите установщик в режиме UEFI."

#: lib/partition_planner.py:230
#, python-brace-format
msgid "No suitable free space available (need at least {need} MiB)"
msgstr "Нет подходящего свободного места (необходимо как минимум {need} МБ)"

#: lib/partition_planner.py:236
msgid "Not enough MBR primary partition slots for this free-space install. Use erase-all, remove a partition, or use a GPT/UEFI layout."
msgstr "Недостаточно основных разделов MBR для установки в свободное пространство. Используйте erase-all, удалите раздел или выберите схему GPT/UEFI."

#: lib/partition_planner.py:274
msgid "The resized free space cannot be represented safely in MiB-aligned partitions."
msgstr "Изменённое свободное пространство нельзя безопасно представить в разделах, выровненных по MiB."

