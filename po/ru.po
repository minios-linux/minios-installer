msgstr "Вложенные схемы разделов нельзя безопасно изменить по размеру"

#: lib/partition_resize.py:41
msgid "Mapped partition layouts cannot be resized safely"
msgstr "Схемы разделов с отображением нельзя безопасно изменить по размеру"

#: lib/partition_resize.py:43
msgid "No partition is available to resize"
msgstr "Нет доступных разделов для изменения размера"

#: lib/partition_resize.py:52
msgid "Exact non-overlapping partition geometry is required"
msgstr "Точная не перекрывающаяся геометрия разделов обязательна"

#: lib/partition_resize.py:69
msgid "No suitable partition can be safely shrunk to make room for MiniOS"
msgstr "Нет подходящего раздела, который можно безопасно уменьшить для размещения MiniOS"

#: lib/partition_resize.py:72
msgid "The resize candidate is mounted"
msgstr "Кандидат на изменение размера смонтирован"

#: lib/partition_resize.py:74
msgid "Exact resize candidate geometry is unavailable"
msgstr "Точная геометрия кандидата на изменение размера недоступна"

#: lib/partition_resize.py:91
msgid "Could not determine the minimum ext filesystem size"
msgstr "Не удалось определить минимальный размер файловой системы ext"

#: lib/partition_resize.py:99
msgid "Could not determine the minimum NTFS size"
msgstr "Не удалось определить минимальный размер NTFS"

#: lib/partition_resize.py:102
msgid "Unsupported filesystem for resizing"
msgstr "Неподдерживаемая файловая система для изменения размера"

#: lib/partition_resize.py:118
msgid "The last partition cannot be shrunk enough safely"
msgstr "Последний раздел нельзя безопасно уменьшить до нужного размера"

