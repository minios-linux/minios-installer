#: lib/partition_planner.py:48
msgid "The EFI payload does not fit the fixed 100 MiB EFI system partition."
msgstr "O payload EFI não cabe na partição do sistema EFI fixa de 100 MiB."

#: lib/partition_planner.py:75
msgid "No partition table was found. Use erase-all to initialize this disk."
msgstr "Nenhuma tabela de partição foi encontrada. Use apagar tudo para inicializar este disco."

#: lib/partition_planner.py:78
msgid "BIOS/MBR layout cannot be used with existing GPT free space. Choose Automatic/UEFI-GPT or erase the disk."
msgstr "O layout BIOS/MBR não pode ser usado com espaço livre GPT existente. Escolha Automático/UEFI-GPT ou apague o disco."

#: lib/partition_planner.py:81
msgid "Existing GPT free space cannot be used from a BIOS boot without BIOS-on-GPT bootloader support. Boot the installer under UEFI, force UEFI/GPT if you know the target firmware supports it, or erase the disk for BIOS/MBR."
msgstr "O espaço livre existente na GPT não pode ser usado para boot via BIOS sem suporte ao bootloader BIOS-on-GPT. Inicie o instalador em modo UEFI, force UEFI/GPT se souber que o firmware de destino suporta, ou apague o disco para BIOS/MBR."

#: lib/partition_planner.py:86
msgid "UEFI/GPT layout cannot be used with existing MBR free space. Choose Automatic/BIOS-MBR or erase the disk."
msgstr "O layout UEFI/GPT não pode ser usado com espaço livre MBR existente. Escolha Automático/BIOS-MBR ou apague o disco."

#: lib/partition_planner.py:106
#, python-brace-format
msgid "Not enough space for MiniOS root partition (need at least {need} MiB, have {have} MiB)"
msgstr "Espaço insuficiente para a partição raiz do MiniOS (necessário pelo menos {need} MiB, disponível {have} MiB)"

#: lib/partition_planner.py:151
msgid "BIOS firmware cannot reliably boot a GPT layout. Erase-all requires MBR on BIOS; disks 2 TiB or larger are not supported in this mode. Use a smaller disk or boot the installer under UEFI."
msgstr "Firmware BIOS não consegue inicializar um layout GPT de forma confiável. Apagar tudo exige MBR no BIOS; discos de 2 TiB ou maiores não são suportados nesse modo. Use um disco menor ou inicialize o instalador em UEFI."

#: lib/partition_planner.py:248
#, python-brace-format
msgid "No suitable free space available (need at least {need} MiB)"
msgstr "Não há espaço livre adequado disponível (necessário pelo menos {need} MiB)"

#: lib/partition_planner.py:254
msgid "Not enough MBR primary partition slots for this free-space install. Use erase-all, remove a partition, or use a GPT/UEFI layout."
msgstr "Não há slots primários MBR suficientes para esta instalação em espaço livre. Use apagar tudo, remova uma partição ou utilize um layout GPT/UEFI."

#: lib/partition_planner.py:294
msgid "The resized free space cannot be represented safely in MiB-aligned partitions."
msgstr "O espaço livre redimensionado não pode ser representado com segurança em partições alinhadas por MiB."

#: lib/partition_planner.py:306
msgid "This placement mode is not implemented yet"
msgstr "Este modo de alocação ainda não foi implementado"

#: lib/partition_planner.py:307
#, python-brace-format
msgid "Unsupported placement: {placement}"
msgstr "Alocação não suportada: {placement}"

#: lib/partition_resize.py:33
msgid "Exact partition geometry is unavailable"
msgstr "A geometria exata da partição não está disponível"

#: lib/partition_resize.py:35
msgid "Nested partition layouts cannot be resized safely"
msgstr "Layouts de partição aninhados não podem ser redimensionados com segurança"

#: lib/partition_resize.py:37
msgid "Mapped partition layouts cannot be resized safely"
msgstr "Layouts de partição mapeados não podem ser redimensionados com segurança"

#: lib/partition_resize.py:39
msgid "No partition is available to resize"
msgstr "Nenhuma partição disponível para redimensionar"

#: lib/partition_resize.py:48
msgid "Exact non-overlapping partition geometry is required"
msgstr "É necessária a geometria exata e sem sobreposição da partição"

#: lib/partition_resize.py:64
msgid "No suitable partition can be safely shrunk to make room for MiniOS"
msgstr "Nenhuma partição adequada pode ser reduzida com segurança para abrir espaço para o MiniOS"

#: lib/partition_resize.py:66
msgid "The resize candidate is mounted"
msgstr "O candidato ao redimensionamento está montado"

#: lib/partition_resize.py:68
msgid "Exact resize candidate geometry is unavailable"
msgstr "Geometria exata do candidato ao redimensionamento indisponível"

#: lib/partition_resize.py:85
msgid "Could not determine the minimum ext filesystem size"
msgstr "Não foi possível determinar o tamanho mínimo do sistema de arquivos ext"

#: lib/partition_resize.py:93
msgid "Could not determine the minimum NTFS size"
msgstr "Não foi possível determinar o tamanho mínimo do NTFS"

#: lib/partition_resize.py:96
msgid "Unsupported filesystem for resizing"
msgstr "Sistema de arquivos não suportado para redimensionamento"

#: lib/partition_resize.py:112
msgid "The last partition cannot be shrunk enough safely"
msgstr "A última partição não pode ser reduzida com segurança"

