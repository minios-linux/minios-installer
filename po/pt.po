#: lib/main_installer.py:1513
msgid "Install a live MiniOS system or a full native system."
msgstr "Instale um sistema MiniOS live ou um sistema nativo completo."

#: lib/main_installer.py:1517
msgid "Select modules and disk layout"
msgstr "Selecionar módulos e layout do disco"

#: lib/main_installer.py:1518
msgid "Pick what to install and where it should be written."
msgstr "Escolha o que instalar e onde será gravado."

#: lib/main_installer.py:1522
msgid "Review before writing"
msgstr "Revisar antes de gravar"

#: lib/main_installer.py:1523
