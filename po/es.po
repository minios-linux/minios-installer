#: lib/main_installer.py:1512
msgid "Choose installation type"
msgstr "Elegir tipo de instalación"

#: lib/main_installer.py:1513
msgid "Install a live MiniOS system or a full native system."
msgstr "Instale un sistema MiniOS en vivo o un sistema nativo completo."

#: lib/main_installer.py:1517
msgid "Select modules and disk layout"
msgstr "Seleccionar módulos y esquema de particionado"

#: lib/main_installer.py:1518
msgid "Pick what to install and where it should be written."
msgstr "Elija qué instalar y dónde se escribirá."

#: lib/main_installer.py:1522
msgid "Review before writing"
msgstr "Revisar antes de escribir"

#: lib/main_installer.py:1523
msgid "No disk changes are made until the final confirmation."
msgstr "No se realizarán cambios en el disco hasta la confirmación final."

#: lib/main_installer.py:1547
msgid "Installation Mode"
msgstr "Modo de instalación"

#: lib/main_installer.py:1548
msgid "Choose whether MiniOS should keep its live module layout or be installed as a regular Linux system."
msgstr "Elige si MiniOS debe mantener su modo live o instalarse como un sistema Linux convencional."

#: lib/main_installer.py:1560
msgid "Live system installation"
msgstr "Instalación como sistema live"

#: lib/main_installer.py:1562
msgid "Portable MiniOS with modules. Root account stays like the live image (default root password is toor unless you change it)."
msgstr "MiniOS portátil con módulos. La cuenta root se mantiene como en la imagen live (la contraseña root por defecto es toor, a menos que la cambies)."

#: lib/main_installer.py:1568
msgid "Full installation"
msgstr "Instalación completa"

#: lib/main_installer.py:1570
msgid "Regular Linux install. You create a user account; root is locked by default and you use sudo."
msgstr "Instalación estándar de Linux. Creas una cuenta de usuario; root está bloqueado por defecto y usas sudo."

#: lib/main_installer.py:1637
msgid "Boot Settings"
msgstr "Configuración de arranque"

