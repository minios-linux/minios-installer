#: lib/partition_planner.py:48
msgid "The EFI payload does not fit the fixed 100 MiB EFI system partition."
msgstr "La carga EFI no cabe en la partición del sistema EFI fija de 100 MiB."

#: lib/partition_planner.py:75
msgid "No partition table was found. Use erase-all to initialize this disk."
msgstr "No se encontró ninguna tabla de particiones. Utiliza borrar-todo para inicializar este disco."

#: lib/partition_planner.py:78
msgid "BIOS/MBR layout cannot be used with existing GPT free space. Choose Automatic/UEFI-GPT or erase the disk."
msgstr "La disposición BIOS/MBR no se puede usar con espacio libre GPT existente. Elija Automático/UEFI-GPT o borre el disco."

#: lib/partition_planner.py:81
msgid "Existing GPT free space cannot be used from a BIOS boot without BIOS-on-GPT bootloader support. Boot the installer under UEFI, force UEFI/GPT if you know the target firmware supports it, or erase the disk for BIOS/MBR."
msgstr "El espacio libre existente en GPT no puede usarse para un arranque BIOS sin soporte de gestor de arranque BIOS-on-GPT. Arranca el instalador en modo UEFI, fuerza UEFI/GPT si sabes que el firmware de destino lo soporta, o borra el disco para BIOS/MBR."

#: lib/partition_planner.py:86
msgid "UEFI/GPT layout cannot be used with existing MBR free space. Choose Automatic/BIOS-MBR or erase the disk."
msgstr "La disposición UEFI/GPT no se puede usar con espacio libre MBR existente. Elija Automático/BIOS-MBR o borre el disco."

#: lib/partition_planner.py:106
#, python-brace-format
msgid "Not enough space for MiniOS root partition (need at least {need} MiB, have {have} MiB)"
msgstr "No hay suficiente espacio para la partición raíz de MiniOS (se requieren al menos {need} MiB, disponibles {have} MiB)"

#: lib/partition_planner.py:151
msgid "BIOS firmware cannot reliably boot a GPT layout. Erase-all requires MBR on BIOS; disks 2 TiB or larger are not supported in this mode. Use a smaller disk or boot the installer under UEFI."
msgstr "El firmware BIOS no puede arrancar de forma fiable una disposición GPT. Borrar todo requiere MBR en BIOS; los discos de 2 TiB o más no son compatibles en este modo. Use un disco más pequeño o inicie el instalador en UEFI."

#: lib/partition_planner.py:248
#, python-brace-format
msgid "No suitable free space available (need at least {need} MiB)"
msgstr "No hay espacio libre adecuado disponible (se requieren al menos {need} MiB)"

#: lib/partition_planner.py:254
msgid "Not enough MBR primary partition slots for this free-space install. Use erase-all, remove a partition, or use a GPT/UEFI layout."
msgstr "No hay suficientes ranuras de partición primaria MBR para esta instalación en espacio libre. Usa borrar-todo, elimina una partición o utiliza un esquema GPT/UEFI."

#: lib/partition_planner.py:294
msgid "The resized free space cannot be represented safely in MiB-aligned partitions."
msgstr "El espacio libre redimensionado no se puede representar de forma segura en particiones alineadas a MiB."

#: lib/partition_planner.py:306
msgid "This placement mode is not implemented yet"
msgstr "Este modo de ubicación aún no está implementado"

#: lib/partition_planner.py:307
#, python-brace-format
msgid "Unsupported placement: {placement}"
msgstr "Ubicación no soportada: {placement}"

#: lib/partition_resize.py:33
msgid "Exact partition geometry is unavailable"
msgstr "La geometría exacta de la partición no está disponible"

#: lib/partition_resize.py:35
msgid "Nested partition layouts cannot be resized safely"
msgstr "No es seguro redimensionar diseños de partición anidados"

#: lib/partition_resize.py:37
msgid "Mapped partition layouts cannot be resized safely"
msgstr "No es seguro redimensionar diseños de partición mapeados"

#: lib/partition_resize.py:39
