msgid "Choose mode and security"
msgstr "Pilih mode dan keamanan"

#: lib/main_installer.py:1489
msgid "Configure the system"
msgstr "Konfigurasi sistem"

#: lib/main_installer.py:1490
msgid "Set language, time zone, network, keyboard, and user accounts."
msgstr "Atur bahasa, zona waktu, jaringan, keyboard, dan akun pengguna."

#: lib/main_installer.py:1494
msgid "Choose content and target disk"
msgstr "Pilih konten dan disk tujuan"

#: lib/main_installer.py:1495
msgid "Select MiniOS modules, disk layout, and how live-system changes should be stored."
msgstr "Pilih modul MiniOS, tata letak disk, dan cara penyimpanan perubahan pada live-system."

#: lib/main_installer.py:1499
msgid "Review before installing"
msgstr "Tinjau sebelum instalasi"

#: lib/main_installer.py:1500
msgid "Check the complete configuration and planned disk changes before installation starts."
msgstr "Periksa konfigurasi lengkap dan perubahan disk yang direncanakan sebelum instalasi dimulai."

#: lib/main_installer.py:1523
msgid "Choose how MiniOS should work after installation: as a modular live system or as a regular Linux system."
msgstr "Pilih bagaimana MiniOS akan berjalan setelah instalasi: sebagai sistem live modular atau sebagai sistem Linux biasa."

#: lib/main_installer.py:1525
msgid "This live image supports only live system installation with the current installer."
msgstr "Image live ini hanya mendukung instalasi sistem live dengan installer saat ini."

#: lib/main_installer.py:1527
msgid "Installation Mode"
msgstr "Mode Instalasi"

#: lib/main_installer.py:1540
msgid "Live system installation"
msgstr "Instalasi sistem live"

#: lib/main_installer.py:1542
msgid "Modular live system: keeps MiniOS modules and can save changes between reboots. Designed for portable installations, especially on USB drives."
msgstr "Sistem live modular: mempertahankan modul MiniOS dan dapat menyimpan perubahan antar restart. Dirancang untuk instalasi portabel, terutama pada flashdisk USB."

#: lib/main_installer.py:1548
msgid "Full installation"
msgstr "Instalasi penuh"

#: lib/main_installer.py:1550
msgid "Regular Linux system: MiniOS is unpacked to disk and changes are saved directly. Live modules and separate session storage are not used."
msgstr "Sistem Linux biasa: MiniOS diekstrak ke disk dan perubahan disimpan langsung. Modul live dan penyimpanan sesi terpisah tidak digunakan."

#: lib/main_installer.py:1619
msgid "Full installation is unavailable because this live image does not provide the native-install metadata required by the current installer."
msgstr "Instalasi penuh tidak tersedia karena image live ini tidak menyediakan metadata native-install yang dibutuhkan oleh installer saat ini."

