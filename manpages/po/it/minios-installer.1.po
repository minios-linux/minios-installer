#. type: Plain text
#: en/minios-installer.1:4
msgid "minios-installer - Install MiniOS to disk from live session"
msgstr "minios-installer - Installa MiniOS su disco dalla sessione live"

#. type: SH
#: en/minios-installer.1:4 en/minios-deploy.1:4
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINTASSI"

#. type: Plain text
#: en/minios-installer.1:7
