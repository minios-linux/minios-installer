#. type: Plain text
#: en/minios-installer.1:4
msgid "minios-installer - Install MiniOS to disk from live session"
msgstr "minios-installer — установка MiniOS на диск из живого сеанса"

#. type: SH
#: en/minios-installer.1:4 en/minios-deploy.1:4
#, no-wrap
msgid "SYNOPSIS"
msgstr "СИНТАКСИС"

#. type: Plain text
#: en/minios-installer.1:7
msgid "B<minios-installer> [I<--help>]"
